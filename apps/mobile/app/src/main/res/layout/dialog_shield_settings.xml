<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8FAFC"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="ScamShield"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Call Guardian Status"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real-Time Background Phone Interceptor"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCloseDialog"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="✕"
                android:textColor="#64748B"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Readiness banner -->
        <TextView
            android:id="@+id/tvReadiness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking status..."
            android:textColor="#059669"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Main switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Protect Incoming Phone Calls"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/switchGuardian"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbBankingApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I use mobile banking apps (higher alert priority)"
                android:textColor="#334155"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Readiness checklist -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone Permissions Needed"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/checklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnRecheck"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Grant / Recheck Permissions"
                android:textColor="#1E293B"
                android:background="#E2E8F0"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Server Configuration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ScamShield Server URL"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="https://flatbed-carve-imprint.ngrok-free.dev"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:inputType="textUri"
                android:importantForAutofill="no"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:text="Save &amp; Test Server"
                    android:textColor="#FFFFFF"
                    android:background="#2563EB" />

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#475569"
                android:textSize="11sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Offline demo: works with no server and no internet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Demo (works offline)"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Plays a scam call on this phone and triggers the real vibration and CUT CALL banner. Needs no server and no internet."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <Button
                android:id="@+id/btnRunDemo"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="▶  Run demo scam call"
                android:textColor="#FFFFFF"
                android:background="#059669"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How ScamShield works on real calls:\n1. Answer incoming calls normally.\n2. ScamShield monitors caller speech through speakerphone silently.\n3. If fraud tactics are detected, your phone vibrates and a stealth 'CUT CALL' banner appears.\n4. Opponent hears nothing; you hang up safely."
            android:textColor="#64748B"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
